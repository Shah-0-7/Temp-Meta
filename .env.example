# Server
PORT=3001
NODE_ENV=development

# Web app (Vite). In development this defaults to http://localhost:3001.
# In a production build it is empty (no server) unless you set it to your hosted API.
VITE_API_URL=http://localhost:3001

# Meta Model API (leave blank until keys arrive)
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL_SAM=sam-3.1
META_MODEL_SPARK=muse-spark-1.3
META_MODEL_MUSE_IMAGE=muse-image-1.0

# Decart (optional: Tier C live AI try-on). Off by default. Also needs:
#   pnpm add @decartai/sdk --filter @tryanywhere/web --filter @tryanywhere/server
# Turning it on streams the user's camera to Decart (with consent) and is billed per second.
# The key stays on the server; the browser only receives a 2-minute token from POST /api/token.
FEATURE_REALTIME_TRYON=false
DECART_API_KEY=
DECART_MODEL=lucy-vton-latest
# Hard cap on one live session, in seconds
REALTIME_MAX_SESSION_SECONDS=300
# Token requests per minute per client
RATE_LIMIT_TOKEN_RPM=6
# Browser origins allowed to call the API (production). Also restricts Decart tokens outside dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Provider selection (defaults work without any API keys)
PROVIDER_SEGMENTER=browser-sam
PROVIDER_UNDERSTANDING=heuristic
PROVIDER_NORMALIZER=cutout-only
# local = on-device render (default, nothing leaves your device).
# leffa-space = free AI render through the Leffa model on a Hugging Face Space (see FREE_TRYON_* below).
PROVIDER_GENERATOR=local
PROVIDER_REALTIME=null

# Free hosted try-on model. Used only when PROVIDER_GENERATOR=leffa-space.
# The person's photo is sent to the Space, so the app asks for consent first.
# Public Spaces queue, and free GPU quota is small (2 min/day anonymous, 5 min/day with a free HF token).
# Best for real use: duplicate the Space to your own account and point FREE_TRYON_SPACE_URL at it.
FREE_TRYON_SPACE_URL=https://franciszzj-leffa.hf.space
# Gradio endpoint name. The Space sets none, so this is the function name. Confirm with: pnpm check:free-tryon
FREE_TRYON_API_NAME=leffa_predict_vt
# Optional Hugging Face token (read access). Uses YOUR account's quota. Server-side only, never sent to the browser.
HF_TOKEN=
FREE_TRYON_TIMEOUT_MS=150000
# Parallel renders allowed, to protect the small quota
FREE_TRYON_MAX_CONCURRENT=2

# Image proxy
PROXY_HMAC_SECRET=change-me-in-production
PROXY_MAX_SIZE_MB=10

# Rate limiting
RATE_LIMIT_RESOLVE_RPM=30
RATE_LIMIT_GENERATE_RPM=10
