{
  "name": "tryanywhere",
  "private": true,
  "version": "0.1.0",
  "description": "Universal Virtual Try-On \u2014 see yourself wearing clothes from any online store",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @tryanywhere/server dev\" \"pnpm --filter @tryanywhere/web dev\"",
    "dev:web": "pnpm --filter @tryanywhere/web dev",
    "dev:server": "pnpm --filter @tryanywhere/server dev",
    "build": "pnpm --filter @tryanywhere/engine build && pnpm --filter @tryanywhere/server build && pnpm --filter @tryanywhere/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --build",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs || true"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
